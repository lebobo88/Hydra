{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" doctor --quick",
            "timeout": 20
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-session-contract.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" squads",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-route-directive.ps1\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-block-direct-write.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-block-bash-writes.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-block-direct-pp.ps1\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/iolaus_check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(hydra_gateway__)?hydra_memory__.+$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" doctor --quick",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(hydra_gateway__)?executive_suite__.+$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" doctor --quick",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(hydra_gateway__)?rlm_creative__.+$",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" doctor --quick",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__(hydra_gateway__)?senate__.*",
        "hooks": [
          {
            "type": "command",
            "command": "pwsh -NoProfile -File \"${CLAUDE_PLUGIN_ROOT}/hooks/hydra-doctor.ps1\" doctor --quick",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "python \"${CLAUDE_PLUGIN_ROOT}/hooks/iolaus_log.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^mcp__(hydra_gateway__)?hydra_memory__hydra-mem_write_.+$",
        "hooks": [
          {
            "type": "command",
            "command": "echo postcheck",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^mcp__(hydra_gateway__)?(executive_suite__es|rlm_creative__rlm|senate__senate)_output_write$",
        "hooks": [
          {
            "type": "command",
            "command": "echo postcheck",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo checkpoint-flush",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
