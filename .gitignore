# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
build/
dist/
*.egg

# Hydra runtime state
.hydra/
.harness/
~/.hydra/

# Scratch / verification temp dirs (machine-local; never commit)
.tmp/
.tmp_*

# Ad-hoc cross-repo junctions/symlinks planted at repo root (never commit;
# remove with `cmd /c rmdir` only — recursive delete follows them into sibling repos)
/.candc_link
/_space_sim_link
*_link

# Editor / OS
.vscode/
.idea/
*.swp
.DS_Store
Thumbs.db

# Secrets
.env
.env.*
!.env.example

# Marketing squad symlinks (machine-local; regenerated by scripts/setup.{ps1,sh})
# These point into <AIAPP_BASE>/MarketBliss/squads/marketing-* and must not be committed.
squads/marketing-creative
squads/marketing-ops
squads/marketing-production
squads/marketing-research
squads/marketing-strategy
.tmp-pytest/

# Engine-written plan artifacts (docs/plans/<goal-slug>-<8 hex>.html, one per
# workflow plan revision). They are the plan record for their workflow and stay
# on disk; hand-authored plans in docs/plans/ have no hex suffix and are tracked.
docs/plans/*-[0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f][0-9a-f].html

# Ephemeral scratch artifacts (never track)
.scratch/
